{{!-- The site's "whoami" window as an SVG: HTML in a <foreignObject>, shown on GitHub through <img>. CSS animation only. --}}
<svg xmlns="http://www.w3.org/2000/svg" width="860" height="300" viewBox="0 0 860 300" role="img" aria-label="{{data.name}}, {{data.role}}">
<foreignObject width="860" height="300"><div xmlns="http://www.w3.org/1999/xhtml" style="height:100%"><style>
*{box-sizing:border-box;margin:0}
.w{height:100%;overflow:hidden;font:500 16px/1.6 "Bricolage Grotesque","Trebuchet MS",sans-serif;color:#dcf0de;background:#07150b;border:1px solid #1f4029;border-radius:14px;
  background-image:linear-gradient(rgba(182,224,38,.075) 1px,transparent 1px),linear-gradient(90deg,rgba(182,224,38,.075) 1px,transparent 1px);background-size:28px 28px}
.tb{display:flex;gap:7px;padding:10px 14px;border-bottom:1px solid #1f4029}.tb i{width:11px;height:11px;border-radius:50%;background:#1b9129}.tb i:nth-child(2){background:#b6e026}.tb i:nth-child(3){background:#ff93d3}
.bd{padding:18px 24px}
.cmd,.boot{font-family:"JetBrains Mono",Menlo,Consolas,ui-monospace,monospace}
.cmd{font-size:17px;margin-bottom:12px}.cmd b{color:#c4ee2c}
.nm{position:relative;height:66px;font-weight:800;font-size:52px;line-height:1.2;letter-spacing:-.02em;color:#c4ee2c}
.fr{position:absolute;left:0;top:0;opacity:0;white-space:pre}
.fr::after{content:"";display:inline-block;width:.09em;height:.9em;margin-left:.06em;vertical-align:-.1em;background:#c4ee2c;animation:bl 1s steps(1) infinite}
@keyframes bl{50%{opacity:0}}
{{#each typing}}{{{css}}}
{{/each}}
.tag{font-size:22px;margin:6px 0 14px}.tag i{font-style:normal;color:#ff93d3;margin:0 .35ch}
mark{background:linear-gradient(transparent 55%,rgba(196,238,44,.34) 55%);color:inherit;font-weight:800}
.boot{list-style:none;padding:0;font-size:14px}.boot b{color:#1b9129;margin-right:1ch;white-space:pre}
@media (prefers-reduced-motion:reduce){*{animation:none!important}}
</style><div class="w"><div class="tb"><i></i><i></i><i></i></div><div class="bd">
<p class="cmd"><b>$</b> {{data.sectionHeadings.whoami}}</p>
<div class="nm">{{#each typing}}<span class="fr f{{@index}}">{{text}}</span>{{/each}}</div>
<p class="tag">{{data.role}}<i>/</i>{{t.home_hero_role_pre}} <mark>{{data.company}}</mark></p>
<ul class="boot">{{#each boot}}<li><b>[ OK ]</b>{{this}}</li>{{/each}}</ul>
</div></div></div></foreignObject>
</svg>
