---
// Home page. Starts with just the name and tagline; later commits turn this into a list of sections.
import Base from "../../layouts/Base.astro";
import { langs, messages } from "../../lib/content";

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as string;
const t = messages[lang];
---

<Base lang={lang}>
  <section>
    <h1>{t.name}</h1>
    <p>{t.tagline}</p>
  </section>
</Base>
