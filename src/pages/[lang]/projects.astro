---
// All projects. Same section as on the home page, without the "featured only" filter.
import Base from "../../layouts/Base.astro";
import Projects from "../../sections/projects.astro";
import { langs, m } from "../../lib/content";

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as string;
---

<Base lang={lang} path="projects/" title={m.navbar_projects()}>
  <Projects lang={lang} section={{ type: "projects", key: "projects", heading: "sectionHeadings.projectsAll" }} />
</Base>
