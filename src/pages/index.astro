---
// "/" picks the language in the browser (a static site has no request headers), with Paraglide's strategies:
// the visitor's last pick (cookie), else the browser's languages, else the default. Without JavaScript: the default.
import { data } from "../lib/content";
import { baseLocale } from "../paraglide/runtime.js";
const origin = Astro.site ? Astro.site.origin : "";
---

<!doctype html>
<html lang={baseLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{data.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${origin}/${baseLocale}/`} />
    <noscript><meta http-equiv="refresh" content={`0;url=/${baseLocale}/`} /></noscript>
  </head>
  <body>
    <a href={`/${baseLocale}/`}>{data.name}</a>
    <script>
      import { getLocale, localizeHref } from "../paraglide/runtime.js";
      location.replace(localizeHref("/", { locale: getLocale() }) + location.search + location.hash);
    </script>
  </body>
</html>
