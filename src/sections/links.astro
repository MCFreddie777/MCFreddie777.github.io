---
// Section "links": the entries of content/data.json -> socialLinks, with their labels.
// Usage: { "type": "links", "key": "contact" }  ->  messages: "contact_title" (optional heading)
import { data, t } from "../lib/content";
const { section } = Astro.props as { lang: string; section: Record<string, any> };
const title = section.key ? t(`${section.key}_title`, "") : "";
---

<section>
  {title && <h2>{title}</h2>}
  <p>
    {data.socialLinks.map((l: any, i: number) => <>{i > 0 && " · "}<a href={l.href}>{l.label ?? l.id}</a></>)}
  </p>
</section>
