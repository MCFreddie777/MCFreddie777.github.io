---
// Name (typed, with a deliberate typo that corrects itself), role line, boot lines and the stickers.
import { data, list, m, tr } from "../lib/content";
const { lang, section } = Astro.props as { lang: string; section: Record<string, any> };
const heading = tr(data, section.heading);
const company = data.companyUrl ? `<a href="${data.companyUrl}">${data.company}</a>` : data.company;
---

<section class="hero">
  <p class="ps"><span class="d">$</span> <span id="who" data-text={heading}>{heading}</span></p>
  <div class="namewrap">
    <h1 id="name" aria-label={data.name}>
      <span class="ghost" aria-hidden="true">{data.name}</span><span id="typed" data-wrong={section.nameTypo} data-right={data.name}>{data.name}</span><span class="caret" aria-hidden="true"></span>
    </h1>
    <div class="sticker note"><i class="tape"></i><span>{m.home_hero_ears().replace(" 🎧", "")}</span></div>
  </div>
  <p class="tag">
    {data.role} <i>/</i> {m.home_hero_role_pre()} <mark set:html={company} />
  </p>
  <ul class="boot">
    {list("home_hero_boot").map((line) => <li><b>ok</b>{line}</li>)}
  </ul>
  <div class="stickers">
    <div class="sticker tag-name" aria-hidden="true"><b>{m.home_hero_hi_label()}</b><span>{section.hiName}</span></div>
  </div>
</section>
