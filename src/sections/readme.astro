---
import Window from "../components/Window.astro";
import { data, m, mk, tr } from "../lib/content";
const { lang, section } = Astro.props as { lang: string; section: Record<string, any> };
---

<Window chrome cmd={tr(data, section.heading)}>
  <p class="big" set:html={mk(m.home_readme_intro_1())} />
  <p class="big" set:html={mk(m.home_readme_intro_2())} />
  <p class="big" set:html={mk(m.home_readme_intro_3())} />
</Window>
