---
// Section "projects": cards from src/content/projects/*.json inside a terminal window.
// featuredOnly: only entries with featured_on_landing_page, plus a button to the all-projects page.
import { Icon } from "astro-icon/components";
import Window from "../components/Window.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";
import { data, messages, tr } from "../lib/content";
const { lang, section } = Astro.props as { lang: string; section: Record<string, any> };
const t = messages[lang];
const all = (await getCollection("projects")).sort((a, b) => a.id.localeCompare(b.id));
const projects = section.featuredOnly ? all.filter((p) => p.data.featured_on_landing_page) : all;
---

<Window cmd={tr(data, section.heading)}>
  <div class={`grid${section.featuredOnly ? "" : " all"}`}>
    {projects.map((p) => <ProjectCard project={p} lang={lang} />)}
  </div>
  {
    section.featuredOnly ? (
      <div class="more"><a class="btn pri" href={`/${lang}/projects/`}>{t.projects.all}<Icon name="lucide:arrow-right" class="ico" /></a></div>
    ) : (
      <p class="cd"><a class="btn mono" href={`/${lang}/`}><Icon name="lucide:arrow-left" class="ico" />cd ..</a></p>
    )
  }
</Window>
