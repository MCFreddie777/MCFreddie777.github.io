---
// Easter egg: click anywhere in the window (or the button) to "hire" and get the sudoers joke + exit 0.
// In the message, [text](link:<id>) links to the socialLinks entry with that id.
import { m, resolveLinks } from "../lib/content";
---

<section class="blk glowb armed" id="egg-win">
  <div class="tb"><i></i><i></i><i></i></div>
  <div class="bd">
    <div class="egg">
      <button class="btn mono" id="sudo" type="button">$ sudo hire frantisek</button>
      <div id="eggout" hidden>
        <p class="out" set:html={resolveLinks(m.home_egg_output())} />
        <p class="exit"><span>$</span> exit 0<span class="caret" aria-hidden="true"></span></p>
      </div>
    </div>
  </div>
</section>
