---
// Section "text": a heading and paragraphs from messages.
// Usage in content/data.json: { "type": "text", "key": "about" }  ->  messages: "about_title", "about_body_1", "about_body_2", …
// **bold** and [links](url) work.
import { list, md, t } from "../lib/content";
const { section } = Astro.props as { lang: string; section: Record<string, any> };
const title = t(`${section.key}_title`, "");
const paragraphs = list(`${section.key}_body`);
---

<section>
  {title && <h2>{title}</h2>}
  {paragraphs.map((p) => <p set:html={md(p)} />)}
</section>
