---
// The page shell: <head> (SEO, language alternates), top bar, footer. Pages put their content in the slot.
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import { data, defaultLang, langs, messages, site } from "../lib/content";

interface Props {
  lang: string;
  path?: string; // page path inside a language, e.g. "" or "projects/" (used for the language switcher)
  title?: string;
  description?: string;
}
const { lang, path = "", title, description } = Astro.props;
const t = messages[lang];
const origin = Astro.site ? Astro.site.origin : "";
// SEO: text like the elevAIton landing page: messages seo_home_title and seo_home_description (both optional; the description defaults to intro1-3);
// inner pages are "<title> | <name>".
const pageTitle = title ? `${title.charAt(0).toLocaleUpperCase(lang) + title.slice(1)} | ${data.name}` : (t.seo_home_title ?? data.name);
const intro = [t.intro1, t.intro2, t.intro3].filter(Boolean).join(" ").replace(/\*\*/g, "");
const pageDescription = description ?? t.seo_home_description ?? intro;
const theme = site.defaultTheme && site.defaultTheme !== "system" ? site.defaultTheme : undefined;
---

<!doctype html>
<html lang={lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={`${origin}/${lang}/${path}`} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={`${origin}/${l}/${path}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${origin}/${defaultLang}/${path}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={data.name} />
    <meta property="og:locale" content={lang} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <!-- apply the saved theme before first paint (no flash) -->
    <script is:inline>
      try { var th = localStorage.getItem("theme"); if (th) document.documentElement.dataset.theme = th; } catch (e) {}
    </script>
  </head>
  <body>
    <Nav lang={lang} path={path} />
    <main>
      <slot />
    </main>
    <footer>
      <p>{new Date().getFullYear()} · {t.footer}</p>
    </footer>
    <script>
      // theme toggle: flips between light and dark and remembers the choice
      document.getElementById("theme")?.addEventListener("click", () => {
        const root = document.documentElement;
        const dark = (root.dataset.theme ?? (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light")) === "dark";
        root.dataset.theme = dark ? "light" : "dark";
        try { localStorage.setItem("theme", root.dataset.theme); } catch {}
      });
    </script>
  </body>
</html>
