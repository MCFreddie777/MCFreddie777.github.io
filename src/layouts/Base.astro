---
// The page shell: <head>, top bar, scripts. Pages put their content in the slot.
import "../styles/global.css";
import { existsSync } from "node:fs";
import { SEO } from "astro-seo";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { data, defaultLang, langs, site, t } from "../lib/content";

interface Props {
  lang: string;
  path?: string; // page path inside a language, e.g. "" or "projects/" (used for the language switcher)
  title?: string;
  description?: string;
  noindex?: boolean;
}
const { lang, path = "", title, description, noindex = false } = Astro.props;
// SEO: text like the elevAIton landing page: messages seo_home_title and seo_home_description (both optional; the description defaults to home_readme_intro_1-3);
// inner pages are "<title> | <name>".
const pageTitle = title ? `${title.charAt(0).toLocaleUpperCase(lang) + title.slice(1)} | ${data.name}` : t("seo_home_title", data.name);
const intro = [t("home_readme_intro_1", ""), t("home_readme_intro_2", ""), t("home_readme_intro_3", "")].filter(Boolean).join(" ").replace(/\*\*/g, "");
const pageDescription = description ?? t("seo_home_description", intro);
const origin = Astro.site ? Astro.site.origin : "";
const canonical = `${origin}/${lang}/${path}`;
const alternates = [
  ...langs.map((l) => ({ hrefLang: l, href: `${origin}/${l}/${path}` })),
  { hrefLang: "x-default", href: `${origin}/${defaultLang}/${path}` },
];
// Share preview: public/og/<lang>.png (1200×630), if it exists. og:locale (e.g. en_US) from the message seo_og_locale.
const ogImage = existsSync(`public/og/${lang}.png`) ? `${origin}/og/${lang}.png` : undefined;
const ogLocale = t("seo_og_locale", lang);
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: data.name,
  jobTitle: data.role,
  url: origin,
  sameAs: data.socialLinks.map((l: any) => l.href),
};
---

<!doctype html>
<html lang={lang} data-theme={site.defaultTheme ?? "dark"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/icon.png" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <SEO
      title={pageTitle}
      description={pageDescription}
      canonical={canonical}
      noindex={noindex}
      languageAlternates={alternates}
      openGraph={ogImage
        ? {
            basic: { title: pageTitle, type: "website", image: ogImage, url: canonical },
            optional: { locale: ogLocale, siteName: data.name, description: pageDescription },
            image: { width: 1200, height: 630, type: "image/png", alt: pageTitle },
          }
        : undefined}
      twitter={{ card: ogImage ? "summary_large_image" : "summary", title: pageTitle, description: pageDescription, image: ogImage }}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=JetBrains+Mono:wght@400;700&family=Caveat:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <!-- apply the saved theme before first paint (no flash) -->
    <script is:inline>
      try { var th = localStorage.getItem("theme"); if (th) document.documentElement.dataset.theme = th; } catch (e) {}
    </script>
  </head>
  <body>
    <div id="glow" aria-hidden="true"></div>
    <Nav lang={lang} path={path} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import "../scripts/script";
    </script>
  </body>
</html>
