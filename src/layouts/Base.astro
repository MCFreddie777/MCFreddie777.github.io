---
// The page shell: <head>, top bar, scripts. Pages put their content in the slot.
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { data, defaultLang, langs, messages, site } from "../lib/content";

interface Props {
  lang: string;
  path?: string; // page path inside a language, e.g. "" or "projects/" (used for the language switcher)
  title?: string;
  description?: string;
}
const { lang, path = "", title, description } = Astro.props;
const t = messages[lang];
// SEO: text like the elevAIton landing page: messages seo_home_title and seo_home_description (both optional; the description defaults to intro1-3);
// inner pages are "<title> | <name>".
const pageTitle = title ? `${title.charAt(0).toLocaleUpperCase(lang) + title.slice(1)} | ${data.name}` : (t.seo_home_title ?? data.name);
const intro = [t.intro1, t.intro2, t.intro3].filter(Boolean).join(" ").replace(/\*\*/g, "");
const pageDescription = description ?? t.seo_home_description ?? intro;
const origin = Astro.site ? Astro.site.origin : "";
const canonical = `${origin}/${lang}/${path}`;
const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: data.name,
  jobTitle: data.role,
  url: origin,
  sameAs: data.socialLinks.map((l: any) => l.href),
};
---

<!doctype html>
<html lang={lang} data-theme={site.defaultTheme ?? "dark"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {langs.map((l) => <link rel="alternate" hreflang={l} href={`${origin}/${l}/${path}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${origin}/${defaultLang}/${path}`} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:site_name" content={data.name} />
    <meta property="og:locale" content={lang} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,800&family=JetBrains+Mono:wght@400;700&family=Caveat:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    <!-- apply the saved theme before first paint (no flash) -->
    <script is:inline>
      try { var th = localStorage.getItem("theme"); if (th) document.documentElement.dataset.theme = th; } catch (e) {}
    </script>
  </head>
  <body>
    <div id="glow" aria-hidden="true"></div>
    <Nav lang={lang} path={path} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import "../scripts/script";
    </script>
  </body>
</html>
